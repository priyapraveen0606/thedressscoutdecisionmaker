# Copy to .env and replace the placeholders below.
# Use the helper script: python scripts/create_profile.py
# This keeps the personal anchor profile encrypted and outside the repo source tree.
PERSONAL_PROFILE_SECRET="replace_with_fernet_key"
PERSONAL_PROFILE_ENCRYPTED="replace_with_fernet_encrypted_profile_json"

# Backend-only AI settings. These are never exposed to the browser frontend.
OPENAI_API_KEY="replace_with_openai_key"
OPENAI_MODEL="gpt-4o-mini"

# Optional future crawler/search settings.
CRAWLER_PROVIDER="crawl4ai"
SEARCH_ENGINE_MODE="manual"
